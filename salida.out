       U1 > U4: 0
       U1 = (2, 1, 1)
       U1 > U4: 0
       U1 = (2, 0, 1)
       U1 > U4: 0
       U1 = (2, 3, 1)
       U1 > U4: 1

   Operador >=

       U4 = (2, 1, 1)
       U1 = (1, 1, 1)
       U1 >= U4: 0
       U1 = (0, 1, 1)
       U1 >= U4: 0
       U1 = (2, 3, 0)
       U1 >= U4: 1
